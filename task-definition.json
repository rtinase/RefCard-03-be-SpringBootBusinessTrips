{
  "family": "biztrips-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::898624354809:role/LabRole",
  "taskRoleArn": "arn:aws:iam::898624354809:role/LabRole",
  "containerDefinitions": [
    {
      "name": "biztrips-backend",
      "image": "898624354809.dkr.ecr.us-east-1.amazonaws.com/biztrips-backend:latest",
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "mariadb"
        },
        {
          "name": "SPRING_DATASOURCE_URL",
          "value": "jdbc:mariadb://biztrips-backend-db.cpapxdvvtgxu.us-east-1.rds.amazonaws.com:3306/db_biztrips"
        },
        {
          "name": "SPRING_DATASOURCE_USERNAME",
          "value": "admin"
        },
        {
          "name": "APP_CORS_ALLOWED_ORIGINS",
          "value": "http://localhost:5173,http://biztrips-fe-alb-613393037.us-east-1.elb.amazonaws.com"
        }
      ],
      "secrets": [
        {
          "name": "SPRING_DATASOURCE_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:898624354809:secret:biztrips-backend-db-password-ZTX6AL"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/biztrips-backend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
